---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const {
  src,
  alt = "",
  caption,
  wide = false
} = Astro.props as {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
  temporary?: boolean;
  wide?: boolean;
};
---

<figure class:list={["media-figure", { "media-figure--wide": wide }]}>
  <Image
    src={src}
    alt={alt}
    widths={[960, 1440, 1920, 2560, 3200]}
    sizes="(max-width: 760px) calc(100vw - 40px), min(var(--article-width), calc(100vw - 80px))"
    quality={95}
    loading="lazy"
  />
  {caption && (
    <figcaption>
      <span>{caption}</span>
    </figcaption>
  )}
</figure>
